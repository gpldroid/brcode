---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="BRCode — QR Code Generator"><section class="hero"><div class="container"><h1>BRCode QR Code Generator</h1><p>Generate QR codes directly in your browser.</p></div></section><section class="container"><div class="card qr-grid"><div><label for="qr-input">Text or URL</label><textarea id="qr-input" rows="9" placeholder="https://example.com"></textarea><div class="actions"><button id="generate">Generate QR</button><button id="download">Download</button></div></div><div><div id="qr-preview" class="preview">Your QR code will appear here.</div></div></div></section><script>const i=document.querySelector('#qr-input'),p=document.querySelector('#qr-preview');document.querySelector('#generate').onclick=()=>{const v=i.value.trim();if(!v){p.textContent='Enter text or a URL first.';return}const x=document.createElement('img');x.alt='Generated QR code';x.width=256;x.height=256;x.src='https://api.qrserver.com/v1/create-qr-code/?size=256x256&data='+encodeURIComponent(v);p.replaceChildren(x)};document.querySelector('#download').onclick=()=>{const x=p.querySelector('img');if(!x)return;const a=document.createElement('a');a.href=x.src;a.download='brcode-qr.png';a.target='_blank';a.click()};</script></BaseLayout>