---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — BRCode" description="The requested BRCode page could not be found.">
  <section class="container page">
    <div class="card">
      <span class="eyebrow">404</span>
      <h1>Page not found</h1>
      <p class="muted">The page you requested does not exist or has moved.</p>
      <a class="button-link" href={import.meta.env.BASE_URL}>Back to BRCode</a>
    </div>
  </section>
</BaseLayout>
