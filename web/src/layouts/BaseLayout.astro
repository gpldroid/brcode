---
import '../styles/global.css';
const { title='BRCode', description='BRCode QR Code tools' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>{title}</title><meta name="description" content={description}><link rel="manifest" href={base + 'manifest.webmanifest'}></head><body><header class="site-header"><div class="container"><a class="logo" href={base}>BRCode</a><nav class="nav"><a href={base+'about/'}>About</a><a href={base+'contact/'}>Contact</a><a href={base+'privacy/'}>Privacy</a><a href={base+'terms/'}>Terms</a></nav></div></header><main><slot /></main></body></html>